# Copy to `.env` to override. Every value here is the default.

PORT=3000
HOST=0.0.0.0

# Comma-separated origins allowed to call the API. The Vite dev server ports.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# How long a cached response stays fresh, in seconds. Matches the client's
# staleTime so browser and server agree on what "fresh" means.
CACHE_TTL_SECONDS=300

# Shared secret for POST /admin/cache/purge. Unset disables the endpoint.
ADMIN_PURGE_TOKEN=

# `error` in production, `info` in development.
LOG_LEVEL=info
