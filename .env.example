# Copy to `.env` to override. Every value here is the default, so the app runs
# with no .env file at all.

# Which adapter the service layer resolves to: `mock` or `api`.
# `api` will fail until step 3 lands the real endpoints.
VITE_DATA_SOURCE=mock

# Base URL of the intranet API. Only read when VITE_DATA_SOURCE=api.
VITE_API_BASE_URL=http://localhost:3000

# Artificial delay on every mock call, in milliseconds. Set to 400 or so to see
# loading skeletons during development — they are invisible at 0.
VITE_MOCK_LATENCY_MS=0

# --- authentication ---------------------------------------------------------
# `off` (default) or `msal`. Off runs the whole app with no Entra tenant, which
# is what keeps `npm run dev` and both smoke scripts working locally.
VITE_AUTH_MODE=off

# From the `bajaj-intranet-web` SPA app registration. Required when mode=msal.
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=

# The scope exposed by the `bajaj-intranet-api` registration — NOT a Graph
# scope. Looks like api://00000000-0000-0000-0000-000000000000/access_as_user.
# Leave empty until IT exposes it: requests then go out unauthenticated and the
# API decides, rather than sign-in failing at startup.
VITE_AZURE_API_SCOPE=
